{
  "server": {
    "transport": "http",
    "port": 8080,
    "host": "localhost",
    "enableSafety": true,
    "enableUnsafeChatCommands": true,
    "enableGuiAutomationTools": true,
    "maxAreaSize": 10,
    "allowedCommands": [
      "fill",
      "clone",
      "setblock",
      "summon",
      "tp",
      "give",
      "gamemode",
      "effect",
      "enchant",
      "weather",
      "time",
      "say",
      "tell",
      "title"
    ],
    "requestTimeoutMs": 30000,
    "autoStart": true
  },
  "client": {
    "showNotifications": true,
    "logLevel": "INFO",
    "logCommands": false,
    "saveScreenshotsForDebug": false
  },
  "safety": {
    "maxEntitiesPerCommand": 10,
    "maxBlocksPerCommand": 125000,
    "blockCreativeForAll": true,
    "requireOpForAdminCommands": true
  }
}
